# Backend
# Optional admin token for protected API routes. Leave empty for local dev if backend allows it.
ADMIN_TOKEN=

# Personal ChatGPT Accounts OAuth
# Keep disabled unless you are testing the experimental OAuth flow.
ENABLE_EXPERIMENTAL_CHATGPT_OAUTH=false
CHATGPT_OAUTH_CLIENT_ID=
CHATGPT_OAUTH_AUTH_URL=https://auth.openai.com/oauth/authorize
CHATGPT_OAUTH_TOKEN_URL=https://auth.openai.com/oauth/token
CHATGPT_OAUTH_REDIRECT_URI=http://localhost:8000/api/personal-accounts/oauth/callback
CHATGPT_OAUTH_SCOPE=openid email profile offline_access

# Personal Plan Auto Sync
PERSONAL_PLAN_SYNC_STALE_HOURS=6
PERSONAL_PLAN_SYNC_BATCH_SIZE=5
PERSONAL_PLAN_SYNC_DELAY_SECONDS=2
PERSONAL_PLAN_SYNC_RETRY_MINUTES=45


# Frontend
# Must match ADMIN_TOKEN if backend auth is enabled.
NEXT_PUBLIC_ADMIN_TOKEN=
